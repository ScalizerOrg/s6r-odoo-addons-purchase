<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_purchasequotation_document_image"
        inherit_id="purchase.report_purchasequotation_document"
    >
        <th name="th_description" position="before">
            <th name="th_image">Image</th>
        </th>
        <xpath expr="//td[@id='product']" position="before">
            <td name="td_image" style="width: 72px;">
                <img
                    t-if="order_line.product_id.image_128"
                    t-att-src="image_data_uri(order_line.product_id.image_128)"
                    t-att-alt="order_line.product_id.display_name"
                    class="rounded"
                    style="max-width: 64px; max-height: 64px;"
                />
            </td>
        </xpath>
    </template>
</odoo>
