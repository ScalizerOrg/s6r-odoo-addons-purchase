<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_purchase_bom" model="ir.actions.report">
        <field name="name">Subcontracting BoM</field>
        <field name="model">mrp.bom</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">s6r_purchase_product_document.report_purchase_bom</field>
        <field name="print_report_name">'BoM - %s' % object.display_name</field>
    </record>

    <template id="report_purchase_bom_document">
        <t t-set="product" t-value="(variant and o.env['product.product'].browse(int(variant))) or o.product_id or o.product_tmpl_id"/>
        <t t-set="layout_document_title">
            <span>Bill of Materials <span t-out="o.code or ''"/></span>
        </t>
        <t t-call="web.external_layout" company="(o.company_id or o.env.company).sudo()" layout_document_title="layout_document_title">
            <div class="page">
                <div id="informations" class="row mt-4 mb-4">
                    <div class="col-6">
                        <strong>Product:</strong>
                        <p class="m-0" t-out="product.display_name"/>
                    </div>
                    <div class="col-3">
                        <strong>Quantity:</strong>
                        <p class="m-0"><span t-field="o.product_qty"/> <span t-field="o.uom_id"/></p>
                    </div>
                </div>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th name="th_component">Component</th>
                            <th name="th_quantity" class="text-end">Quantity</th>
                            <th name="th_uom">Unit</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.bom_line_ids" t-as="line">
                            <tr t-if="product._name != 'product.product' or not line._skip_bom_line(product)">
                                <td name="td_component"><span t-out="line.product_id.display_name"/></td>
                                <td name="td_quantity" class="text-end"><span t-field="line.product_qty"/></td>
                                <td name="td_uom"><span t-field="line.uom_id"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_purchase_bom">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="s6r_purchase_product_document.report_purchase_bom_document"/>
            </t>
        </t>
    </template>

</odoo>
