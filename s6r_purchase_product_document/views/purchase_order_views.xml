<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.s6r_purchase_product_document</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_cancel']" position="before">
                <button name="action_preview_purchase_order"
                        string="Preview"
                        type="object"
                        invisible="state == 'cancel'"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_purchase_documents"
                        type="object"
                        class="oe_stat_button"
                        icon="description">
                    <field name="document_count" widget="statinfo" string="Documents"/>
                </button>
            </div>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="before">
                <field name="available_bom_ids" column_invisible="True"/>
                <field name="is_subcontracted" column_invisible="True"/>
                <field name="bom_id"
                       optional="show"
                       invisible="not is_subcontracted"
                       required="is_subcontracted and not display_type"
                       readonly="state in ('to approve', 'purchase', 'cancel')"
                       options="{'no_create': True}"
                       context="{'default_product_id': product_id}"/>
            </xpath>
            <page name="purchase_delivery_invoice" position="before">
                <page string="Documents" name="purchase_documents">
                    <field name="available_product_document_ids" invisible="1"/>
                    <field name="document_ids" readonly="state == 'cancel'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_document_id"
                                   domain="[('id', 'in', parent.available_product_document_ids)]"
                                   options="{'no_create': True}"/>
                            <field name="product_name"/>
                            <field name="attached_on_purchase"/>
                            <field name="mimetype" optional="hide"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

</odoo>
