<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form_purchase" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.s6r_purchase_product_document</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <block name="purchase_setting_container" position="inside">
                <setting id="purchase_product_documents"
                         string="Product Documents"
                         company_dependent="1"
                         help="Append the PDF documents shared with the vendor to these reports">
                    <field name="purchase_document_report_ids"
                           widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <div class="mt8">
                        <label for="purchase_bom_report_id" class="o_light_label"/>
                        <field name="purchase_bom_report_id" options="{'no_create': True}"/>
                    </div>
                </setting>
            </block>
        </field>
    </record>

</odoo>
